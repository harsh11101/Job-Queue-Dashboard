# Copy to .env.local for local development, or set these in the Vercel project settings.
# All are read at build time (Vite inlines VITE_* variables into the bundle).

# Origin of the backend, without a trailing slash. Leave empty to call the same origin
# the dashboard is served from (e.g. behind a reverse proxy that routes /api to the backend).
VITE_API_BASE_URL=http://localhost:8080

# How often live views (overview, lists, an unfinished job) refresh while the tab is visible.
VITE_POLL_INTERVAL_MS=5000

# Every request is aborted after this many milliseconds.
VITE_REQUEST_TIMEOUT_MS=10000
